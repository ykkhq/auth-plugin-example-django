            ]
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "user": 0,
              "route": 1,
              "response_status": 2,
              "Value #A": 3
            },
            "renameByName": {
              "user": "User",
              "route": "Route",
              "response_status": "Status",
              "Value #A": "Requests"
            }
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "logs",
      "title": "Recent authenticated requests",
      "description": "",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{source=\"kong\", route=~\"$route\"} | json | user != \"\" | user =~ \"$user\" | line_format \"{{.user}}  {{.request_method}} {{.request_uri}} -> {{.response_status}}  {{.latencies_request}} ms  [{{.route_name}}]\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
