# Auth0 settings for the openid-connect plugin in kong/kong.yaml.
# cp kong/auth0.env.example kong/auth0.env  (gitignored), fill in, then:
#   source kong/auth0.env && deck gateway sync kong/kong.yaml ...

# Auth0 tenant domain (Settings > Domain), used only by the curl examples
export AUTH0_DOMAIN=your-tenant.us.auth0.com

# OIDC discovery URL of the tenant
export DECK_AUTH0_ISSUER="https://${AUTH0_DOMAIN}/.well-known/openid-configuration"
# Issuer identifier (trailing slash), advertised to MCP clients as the
# authorization server. start.sh derives it from AUTH0_DOMAIN when unset.
export DECK_AUTH0_ISSUER_URL="https://${AUTH0_DOMAIN}/"

# "Regular Web Application" (browser login)
export DECK_AUTH0_WEB_CLIENT_ID=REPLACE_WITH_WEB_APP_CLIENT_ID
export DECK_AUTH0_WEB_CLIENT_SECRET=REPLACE_WITH_WEB_APP_CLIENT_SECRET

# Auth0 API identifier (audience of the access tokens)
export DECK_AUTH0_AUDIENCE=https://inventory-api

# Kong session cookie encryption secret / token cache salt.
# Generate once and keep fixed; changing them logs every browser out.
export DECK_OIDC_SESSION_SECRET=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_32
export DECK_OIDC_CACHE_TOKENS_SALT=REPLACE_WITH_OUTPUT_OF_openssl_rand_hex_16

# "Machine to Machine Application" (curl / apps), used only by the curl examples
export AUTH0_M2M_CLIENT_ID=REPLACE_WITH_M2M_CLIENT_ID
export AUTH0_M2M_CLIENT_SECRET=REPLACE_WITH_M2M_CLIENT_SECRET

# "Native" application for MCP clients (Auth0 user login, MCP_README "OIDC"):
# public client with PKCE, Allowed Callback URL http://localhost:8765/callback,
# allowed to request the two MCP APIs (identifier = audience = MCP resource):
#   https://localhost:8443/gw-mcp/mfg      (Kong GW, ai-mcp-oauth2)
#   https://localhost:11443/mcp-oidc/mfg   (AI GW OIDC servers)
# and tenant setting "Resource Parameter Compatibility Profile" enabled, so the
# RFC 8707 resource parameter the MCP client sends picks the audience.
# Used by `claude mcp add --client-id` (no secret), and handed out by Kong's
# /register to MCP clients on the 2025-03-26 spec (kong/kong-mcp-legacy-auth.yaml).
export AUTH0_MCP_CLIENT_ID=REPLACE_WITH_MCP_NATIVE_APP_CLIENT_ID
# MCP tools by role need no variables here: Auth0 roles sales/manager/admin on the
# users + a Post-Login Action that sets the access-token claim mfg_roles
# (MCP_README "Tools by role").
